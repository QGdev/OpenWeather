<!--
    Data extraction rules for Android 12+ (API 31+).
    Mirrors the existing allowBackup="false" / fullBackupContent="false" policy:
    no cloud backup and no device-to-device transfer for any app data.
    Encrypted preferences (API key, settings) must never leave the device.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>

