<!--
  The large and medium widgets. The medium one hides the measures and the last two hours.
  The sky is a bitmap painted by WidgetsBinder: RemoteViews cannot draw a gradient from code.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.OpenWeather.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sky_clip"
    android:padding="0dp"
    android:theme="@style/MaterialTheme.AppWidgetContainer">

    <ImageView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_sky_frame" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/city"
                    style="@style/Widget.OpenWeather.Sky.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/condition"
                    style="@style/Widget.OpenWeather.Sky.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/temperature"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textSize="30sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- Icons as ImageViews rather than compound drawables, so they can be tinted from code. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/temperature_max_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/temperature_maximum_material" />

                    <TextView
                        android:id="@+id/temperature_max"
                        style="@style/Widget.OpenWeather.Sky.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/temperature_min_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/temperature_minimum_material" />

                    <TextView
                        android:id="@+id/temperature_min"
                        style="@style/Widget.OpenWeather.Sky.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- The height left over is shared between the gaps, so a tall widget stays balanced. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/metrics_divider"
            style="@style/Widget.OpenWeather.Sky.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/metric_1_label"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/metric_1_value"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/metric_2_label"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/metric_2_value"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/metric_3_label"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/metric_3_value"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/metric_4_label"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/metric_4_value"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp" />
        </LinearLayout>
        </LinearLayout>

        <!-- The height left over is shared between the gaps, so a tall widget stays balanced. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/hours_divider"
            style="@style/Widget.OpenWeather.Sky.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hour_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hour_1_time"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/hour_1_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="2dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/hour_1_temperature"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hour_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hour_2_time"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/hour_2_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="2dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/hour_2_temperature"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hour_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hour_3_time"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/hour_3_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="2dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/hour_3_temperature"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hour_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hour_4_time"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/hour_4_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="2dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/hour_4_temperature"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hour_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hour_5_time"
                style="@style/Widget.OpenWeather.Sky.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/hour_5_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginVertical="2dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/hour_5_temperature"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
