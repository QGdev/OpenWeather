<!--
  The small widget, one row. Narrow, it shows the icon and the temperature only: the icon rather
  than the city name, which would only be truncated there. Wider, and when its settings allow it,
  WidgetsBinder reveals the place, today's range and the next hours, in that order.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.OpenWeather.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sky_clip"
    android:padding="0dp"
    android:theme="@style/MaterialTheme.AppWidgetContainer">

    <ImageView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_sky_frame" />

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/weather_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/temperature"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/stale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E0704A"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/city"
                style="@style/Widget.OpenWeather.Sky.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/condition"
                style="@style/Widget.OpenWeather.Sky.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/temperature_max_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/temperature_maximum_material" />

                <TextView
                    android:id="@+id/temperature_max"
                    style="@style/Widget.OpenWeather.Sky.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/temperature_min_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/temperature_minimum_material" />

                <TextView
                    android:id="@+id/temperature_min"
                    style="@style/Widget.OpenWeather.Sky.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_hours"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row_hour_1_time"
                    style="@style/Widget.OpenWeather.Sky.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/row_hour_1_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginVertical="1dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/row_hour_1_temperature"
                    style="@style/Widget.OpenWeather.Sky.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row_hour_2_time"
                    style="@style/Widget.OpenWeather.Sky.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/row_hour_2_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginVertical="1dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/row_hour_2_temperature"
                    style="@style/Widget.OpenWeather.Sky.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row_hour_3_time"
                    style="@style/Widget.OpenWeather.Sky.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/row_hour_3_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginVertical="1dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/row_hour_3_temperature"
                    style="@style/Widget.OpenWeather.Sky.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
