<resources>
    <!--
    Having themes.xml for v31 variant because @android:dimen/system_app_widget_background_radius
     and @android:dimen/system_app_widget_internal_padding requires API level 31
    -->
    <style name="MaterialTheme.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="appWidgetRadius">@android:dimen/system_app_widget_background_radius</item>
        <item name="appWidgetInnerRadius">@android:dimen/system_app_widget_inner_radius</item>
    </style>

    <!--
      The system shows its own launch screen before any activity on Android 12 and later, and it
      cannot be turned off. It is made to look like the first frame of SplashScreenActivity - the
      same ground, no icon - so the two read as one screen instead of a logo in a circle followed
      by a second splash.
    -->
    <style name="SplashActivity" parent="MaterialTheme">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>